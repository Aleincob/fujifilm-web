---
import Layout from '../layouts/Layout.astro';
import Header from '../components/sections/Header.astro';
import CanvasHero from '../components/canvas/CanvasHero';
---

<Layout title="FUJIFILM X100VI — El arte de ver el mundo">
  <div id="top" class="relative w-full">
    <!-- Sticky Glassmorphic Header -->
    <Header />

    <main class="w-full">
      <!-- Hero Scrollytelling Canvas 180 Frames (Fase 2) -->
      <div id="overview" class="w-full">
        <CanvasHero client:load />
      </div>

      <!-- Section Anchors for Lenis Testing & Structure Alignment -->
      <section id="optics" class="py-24 px-4 max-w-6xl mx-auto border-b border-white/[0.06]">
        <div class="flex flex-col items-center text-center">
          <span class="text-xs font-mono tracking-widest text-neutral-500 uppercase mb-3">02 / ANATOMÍA ÓPTICA</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">40.2 Megapíxeles. Sin compromisos.</h2>
          <p class="text-neutral-400 max-w-xl text-sm leading-relaxed mb-8">
            Sensor X-Trans CMOS 5 HR con sistema IBIS de 5 ejes y objetivo FUJINON 23mm f/2 II integrado.
          </p>
          <div class="w-full max-w-2xl aspect-[16/9] rounded-xl border border-white/10 overflow-hidden bg-neutral-900/40">
            <img src="/images/img-overview-exploded.webp" alt="Exploded view preview" class="w-full h-full object-contain opacity-75" />
          </div>
        </div>
      </section>

      <section id="mechanics" class="py-24 px-4 max-w-6xl mx-auto border-b border-white/[0.06]">
        <div class="flex flex-col items-center text-center">
          <span class="text-xs font-mono tracking-widest text-neutral-500 uppercase mb-3">03 / CONTROL TÁCTIL</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">La memoria en la punta de tus dedos.</h2>
          <p class="text-neutral-400 max-w-xl text-sm leading-relaxed mb-8">
            Diales torneados en bloques de aluminio macizo con respuesta háptica calculada.
          </p>
          <div class="w-full max-w-xl aspect-video rounded-xl border border-white/10 overflow-hidden bg-neutral-900/40">
            <video
              src="/videos/dials-ambient.mp4"
              class="w-full h-full object-cover"
              autoplay
              loop
              muted
              playsinline
            ></video>
          </div>
        </div>
      </section>

      <section id="gallery" class="py-24 px-4 max-w-6xl mx-auto border-b border-white/[0.06]">
        <div class="flex flex-col items-center text-center">
          <span class="text-xs font-mono tracking-widest text-neutral-500 uppercase mb-3">04 / SIMULACIONES DE PELÍCULA</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">80 años de química encapsulados.</h2>
          <p class="text-neutral-400 max-w-xl text-sm leading-relaxed mb-8">
            20 perfiles cromáticos de leyenda incluyendo el nuevo perfil REALA ACE.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 w-full">
            <div class="rounded-xl border border-white/10 overflow-hidden bg-neutral-900/40 aspect-[4/3] relative group">
              <img src="/images/gallery-01-reala.webp" alt="Reala Ace" class="w-full h-full object-cover" />
              <div class="absolute bottom-2 left-2 px-2 py-1 bg-black/70 rounded text-[10px] font-mono text-neutral-300">REALA ACE</div>
            </div>
            <div class="rounded-xl border border-white/10 overflow-hidden bg-neutral-900/40 aspect-[4/3] relative group">
              <img src="/images/gallery-02-acros.webp" alt="Acros" class="w-full h-full object-cover" />
              <div class="absolute bottom-2 left-2 px-2 py-1 bg-black/70 rounded text-[10px] font-mono text-neutral-300">ACROS</div>
            </div>
            <div class="rounded-xl border border-white/10 overflow-hidden bg-neutral-900/40 aspect-[4/3] relative group">
              <img src="/images/gallery-03-chrome.webp" alt="Classic Chrome" class="w-full h-full object-cover" />
              <div class="absolute bottom-2 left-2 px-2 py-1 bg-black/70 rounded text-[10px] font-mono text-neutral-300">CLASSIC CHROME</div>
            </div>
          </div>
        </div>
      </section>

      <section id="specs" class="py-24 px-4 max-w-6xl mx-auto border-b border-white/[0.06]">
        <div class="flex flex-col items-center text-center">
          <span class="text-xs font-mono tracking-widest text-neutral-500 uppercase mb-3">05 / ESPECIFICACIONES TÉCNICAS</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Ingeniería sin concesiones.</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 w-full max-w-3xl mt-6 text-left">
            <div class="p-4 rounded-xl border border-white/10 bg-neutral-900/40">
              <div class="text-2xl font-bold text-white mb-1">40.2 MP</div>
              <div class="text-xs text-neutral-400">Sensor X-Trans CMOS 5 HR</div>
            </div>
            <div class="p-4 rounded-xl border border-white/10 bg-neutral-900/40">
              <div class="text-2xl font-bold text-white mb-1">6.0 Pasos</div>
              <div class="text-xs text-neutral-400">IBIS 5 Ejes Integrado</div>
            </div>
            <div class="p-4 rounded-xl border border-white/10 bg-neutral-900/40">
              <div class="text-2xl font-bold text-white mb-1">6.2K 30p</div>
              <div class="text-xs text-neutral-400">Grabación interna 4:2:2</div>
            </div>
            <div class="p-4 rounded-xl border border-white/10 bg-neutral-900/40">
              <div class="text-2xl font-bold text-white mb-1">521 g</div>
              <div class="text-xs text-neutral-400">Cuerpo compacto y ágil</div>
            </div>
          </div>
        </div>
      </section>

      <section id="preorder" class="py-28 px-4 max-w-6xl mx-auto text-center">
        <span class="text-xs font-mono tracking-widest text-neutral-500 uppercase mb-3">06 / RESERVA TU EJEMPLAR</span>
        <h2 class="text-3xl sm:text-5xl font-bold text-white mb-6">La próxima toma te está esperando.</h2>
        <p class="text-neutral-400 max-w-lg mx-auto text-sm mb-8">
          Disponible en acabado Silver clásico y Black sigiloso.
        </p>
        <div class="w-full max-w-xl mx-auto rounded-2xl border border-white/10 overflow-hidden mb-8">
          <img src="/images/preorder-duo.webp" alt="X100VI Silver & Black" class="w-full h-auto object-cover" />
        </div>
        <button class="px-8 py-3.5 rounded-full text-xs font-semibold tracking-wider text-black bg-white hover:bg-neutral-100 hover:shadow-[0_0_25px_rgba(255,255,255,0.25)] transition-all cursor-pointer">
          Pre-order Ahora — $1,599 USD
        </button>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/[0.08] py-12 px-4 text-center text-xs text-neutral-500">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>© FUJIFILM Corporation. Todos los derechos reservados.</div>
        <div class="flex items-center gap-6">
          <a href="#overview" class="hover:text-neutral-300 transition-colors">Inicio</a>
          <a href="#specs" class="hover:text-neutral-300 transition-colors">Especificaciones</a>
          <a href="#preorder" class="hover:text-neutral-300 transition-colors">Pre-order</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>
