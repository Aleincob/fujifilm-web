---
import Layout from '../layouts/Layout.astro';
import Header from '../components/sections/Header.astro';
import CanvasHero from '../components/canvas/CanvasHero';
import ExplodedView from '../components/sections/ExplodedView';
import TactileMechanics from '../components/sections/TactileMechanics.astro';
import FilmSimulations from '../components/sections/FilmSimulations';
import SpecsMatrix from '../components/sections/SpecsMatrix';
import PreorderShowcase from '../components/sections/PreorderShowcase';
import Footer from '../components/sections/Footer.astro';
---

<Layout title="FUJIFILM X100VI — El arte de ver el mundo">
  <div id="top" class="relative w-full">
    <!-- Sticky Glassmorphic Header -->
    <Header />

    <main class="w-full">
      <!-- Hero Scrollytelling Canvas 180 Frames (Fase 2) -->
      <div id="overview" class="w-full">
        <CanvasHero client:load />
      </div>

      <!-- Exploded View Óptico con Hotspots Interactivos (Fase 3) -->
      <ExplodedView client:visible />

      <!-- Video Ambient Macro Diales & Control Analógico (Fase 3) -->
      <TactileMechanics />

      <!-- Laboratorio de Simulaciones de Película (Fase 4) -->
      <FilmSimulations client:visible />

      <!-- Matriz de Especificaciones Técnicas Pro (Fase 4) -->
      <SpecsMatrix client:visible />

      <!-- Pre-Order & Dual-Tone Showcase (Fase 5) -->
      <PreorderShowcase client:visible />
    </main>

    <!-- Global Brand & Legal Footer (Fase 5) -->
    <Footer />
  </div>
</Layout>
